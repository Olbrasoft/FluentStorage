{
    "CodeGPT.apiKey": "Ollama",
    "dotnet.defaultSolution": "FluentStorage.sln",
    "dotnet.completion.showCompletionItemsFromUnimportedNamespaces": true,
    "dotnet.unitTests.runSettingsPath": "",
    "testExplorer.useNativeTesting": true,
    "dotnet.unitTests.enableCodeLens": true,
    "csharp.semanticHighlighting.enabled": true,
    "omnisharp.enableRoslynAnalyzers": true,
    "omnisharp.useModernNet": true,
    "debug.allowBreakpointsEverywhere": true,
    "debug.showInlineBreakpointCandidates": true,
    "debug.showSubSessionsInToolBar": true,
    "csharp.debug.justMyCode": true,
    "csharp.debug.suppressJITOptimizations": true,
    "csharp.debug.enableStepFiltering": true
}